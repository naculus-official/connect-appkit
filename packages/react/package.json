{
  "name": "@naculus/connect-appkit-react",
  "version": "0.2.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@naculus/connect-appkit-core": "workspace:*",
    "@naculus/connect-appkit-wc": "workspace:*",
    "@naculus/connect-core": "^0.2.1",
    "@naculus/connector-embedded": "^0.2.1",
    "@naculus/connector-evm-injected": "^0.2.1",
    "@naculus/connector-passkeys": "^0.2.1",
    "@naculus/connector-solana": "^0.2.1",
    "@naculus/connector-walletconnect": "^0.2.1",
    "@naculus/siwx": "^0.2.1",
    "@naculus/wallet-engine": "^0.2.1",
    "@stencil/react-output-target": "^1.6.2",
    "viem": "^2.56.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/naculus-official/connect-appkit.git"
  },
  "license": "MIT",
  "description": "React hooks and components for Naculus Connect — auto-generated wrappers for Stencil Web Components",
  "homepage": "https://github.com/naculus-official/connect-appkit#readme",
  "bugs": "https://github.com/naculus-official/connect-appkit/issues",
  "keywords": [
    "web3",
    "wallet",
    "connect",
    "ui",
    "components",
    "react"
  ],
  "optionalDependencies": {
    "@naculus/connect-appkit-ui": "workspace:*"
  }
}
