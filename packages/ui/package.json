{
  "name": "@naculus/connect-appkit-ui",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": {
      "default": "./dist/styles/index.css"
    },
    "./styles/utilities": {
      "default": "./dist/styles/utilities.css"
    },
    "./styles/tokens": {
      "default": "./dist/styles/tokens.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "clean": "rm -rf dist",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@naculus/siwx": "^0.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@naculus/connect-appkit-core": "^0.3.0",
    "@naculus/connect-appkit-react": "^0.3.0",
    "@naculus/connect-core": "^0.3.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@naculus/connect-appkit-core": "workspace:*",
    "@naculus/connect-appkit-react": "workspace:*",
    "@naculus/connect-core": "^0.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/naculus-official/connect-appkit.git"
  },
  "license": "MIT",
  "description": "Naculus Connect UI — base styles, CSS tokens, and legacy shadcn contexts",
  "homepage": "https://github.com/naculus-official/connect-appkit#readme",
  "bugs": "https://github.com/naculus-official/connect-appkit/issues",
  "keywords": [
    "web3",
    "wallet",
    "connect",
    "ui",
    "design-tokens",
    "css"
  ]
}
