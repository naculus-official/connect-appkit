{
  "name": "@naculus/connect-appkit-core",
  "version": "0.2.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@naculus/connect-core": "^0.2.0"
  },
  "devDependencies": {
    "@naculus/connect-core": "^0.2.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/naculus-official/connect-appkit.git"
  },
  "license": "MIT",
  "description": "Naculus Connect AppKit — framework-neutral state, chain and token logic shared by the React and Vue bindings",
  "homepage": "https://github.com/naculus-official/connect-appkit#readme",
  "bugs": "https://github.com/naculus-official/connect-appkit/issues",
  "keywords": [
    "web3",
    "wallet",
    "connect",
    "caip-2",
    "framework-agnostic"
  ]
}
