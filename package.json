{
  "name": "connect-appkit",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm -r build",
    "build-storybook": "storybook build",
    "clean": "pnpm -r clean",
    "lint": "biome lint",
    "publish:local": "pnpm -r publish --no-git-checks --registry http://localhost:4873",
    "publish:npm": "pnpm -r publish --no-git-checks --registry https://registry.npmjs.org",
    "release": "node -e \"const v=require('./packages/react/package.json').version; console.log(v);\"",
    "release:preflight": "node scripts/release-preflight.mjs",
    "spell-check": "cspell lint \"**/*.{ts,tsx,md}\"",
    "spell-fix": "cspell lint --fix \"**/*.{ts,tsx,md}\"",
    "storybook": "storybook dev -p 61000",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@changesets/cli": "^3.0.3",
    "@microsoft/api-extractor": "^7.59.1",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "cspell": "^10.3.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "viem": "^2.56.5",
    "vitest": "^5.0.0",
    "wagmi": "^3.7.7"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16"
  }
}
