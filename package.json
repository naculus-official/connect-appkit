{
  "name": "connect-appkit",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "pnpm -r clean",
    "publish:local": "pnpm -r publish --no-git-checks --registry http://localhost:4873",
    "publish:npm": "pnpm -r publish --no-git-checks --registry https://registry.npmjs.org",
    "release": "node -e \"const v=require('./packages/react/package.json').version; console.log(v);\"",
    "lint": "biome lint",
    "spell-check": "cspell lint \"**/*.{ts,tsx,md}\"",
    "spell-fix": "cspell lint --fix \"**/*.{ts,tsx,md}\"",
    "storybook": "storybook dev -p 61000",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@changesets/cli": "^2.31.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@storybook/react-vite": "^10.5.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.9",
    "cspell": "^10.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "viem": "^2.54.6",
    "vitest": "^4.1.9",
    "wagmi": "^3.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12"
  }
}
